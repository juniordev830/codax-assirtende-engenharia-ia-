# Provedor ativo: openai, openrouter, groq, deepseek, together, ollama ou lmstudio.
# Gemini e Claude aparecem no catálogo, mas ainda precisam de adaptadores nativos.
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini

# Chave do provedor selecionado. Não envie para o GitHub nem para o frontend.
# Compatibilidade retroativa: OPENAI_API_KEY ainda é aceita quando AI_API_KEY estiver vazia.
AI_API_KEY=
OPENAI_API_KEY=cole_sua_chave_aqui

# URL base opcional para APIs compatíveis com OpenAI.
# OpenAI: deixe vazia. OpenRouter: https://openrouter.ai/api/v1
# Groq: https://api.groq.com/openai/v1
# DeepSeek: https://api.deepseek.com
# Together AI: https://api.together.xyz/v1
# Ollama: http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1
AI_BASE_URL=

# Controle local conservador; USD, não BRL. O padrão de US$ 4,50 deixa margem
# abaixo de R$ 30, mas confira câmbio, impostos e o painel oficial do provedor.
JARVIS_MONTHLY_BUDGET_USD=4.50

# Preços estimados em USD por milhão de tokens para o modelo configurado.
# Atualize estes valores ao trocar de modelo/provedor. São estimativas, não teto garantido.
JARVIS_INPUT_PRICE_PER_MILLION=0.75
JARVIS_OUTPUT_PRICE_PER_MILLION=4.50

# Opcional: diretório local para o banco SQLite (não versionar esse diretório).
# JARVIS_DATA_DIR=C:\Users\SeuUsuario\AppData\Local\JarvisDev
