# Copie este arquivo para .env e adicione sua chave da API.
# Nunca envie a chave para o GitHub nem a coloque no frontend.
OPENAI_API_KEY=cole_sua_chave_aqui
OPENAI_MODEL=gpt-5.4-mini

# Acesso remoto: segredo aleatório de pelo menos 32 caracteres, nunca no frontend.
CODAX_ACCESS_TOKEN=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Módulo GitHub somente para leitura: usuário dono dos repositórios públicos.
# Não requer nem aceita token GitHub; repositórios privados ficam indisponíveis.
CODAX_GITHUB_OWNER=juniordev830
